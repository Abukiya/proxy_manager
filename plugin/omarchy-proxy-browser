#!/bin/bash
# abukiya.proxy browser wrapper. Reads the live gateway at launch time so
# launchers/keybinds always proxy through the current hotspot gateway.
# The browser binary is derived from this script's own filename, so the
# launcher only needs the wrapper path as the first Exec token.
STATE_FILE="$HOME/.config/hotspot-proxy/gateway"
SELF=$(basename "$0")
BIN=${SELF#omarchy-proxy-}
[[ -z $BIN || $BIN == "$SELF" ]] && BIN="chromium"
command -v "$BIN" >/dev/null 2>&1 || BIN="chromium"

if [[ -f "$STATE_FILE" ]]; then
  GW=$(cat "$STATE_FILE")
  exec "$BIN" --proxy-server="$GW" "$@"
else
  exec "$BIN" "$@"
fi
